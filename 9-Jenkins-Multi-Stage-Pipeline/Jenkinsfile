
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install --upgrade pip
                    .venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '.venv/bin/python -m unittest discover -s .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$WORKSPACE/python-app-deploy"
                    cp app.py "$WORKSPACE/python-app-deploy/"
                    cp requirements.txt "$WORKSPACE/python-app-deploy/"
                '''
            }
        }

        stage('Test Deployed Application') {
            steps {
                echo 'Testing the deployed application...'
                sh '''
                    cd "$WORKSPACE/python-app-deploy"
                    PYTHONPATH="$WORKSPACE" "$WORKSPACE/.venv/bin/python" "$WORKSPACE/test_app.py"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
